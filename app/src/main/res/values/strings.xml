    <string name="settings_about">About HamSeda</string>
    <string name="about_text">HamSeda is an offline walkie-talkie: no internet, no account, no server. Voice travels only between two authenticated phones with end-to-end encryption.</string>
    <string name="version_label">Version</string>

    <!-- Privacy -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_p1">No account, no sign-in, no subscription.</string>
    <string name="privacy_p2">No internet: everything (discovery, connection, calls) uses only the phone’s local radios.</string>
    <string name="privacy_p3">No audio storage: no audio files, call history, or contact lists are saved.</string>
    <string name="privacy_p4">Voice is sent only during an active session and only to the authenticated peer; the microphone never stays open outside the push-to-talk button.</string>
    <string name="privacy_p5">Application-layer end-to-end encryption (ECDH on P-256, HKDF-SHA-256 key derivation, AES-256-GCM) on all audio and control frames; keys are ephemeral and wiped from memory when the session ends.</string>
    <string name="privacy_p6">No behavioral analytics, ads, or cloud crash reporting.</string>

    <!-- Permissions -->
    <string name="perm_title">Permission needed</string>
    <string name="perm_wifi_message">To find nearby phones with Wi-Fi Direct, Android requires this permission. Your location is never stored or sent anywhere.</string>
    <string name="perm_bt_message">To find and connect to a nearby phone with Bluetooth, Android requires these permissions.</string>
    <string name="perm_localnet_message">On Android 17, connecting to a nearby phone over Wi-Fi Direct needs local-network access. HamSeda only talks to the peer you choose — nothing is sent to the internet.</string>
    <string name="perm_mic_message">To send voice, microphone access is needed; recording happens only while you hold the button.</string>
    <string name="perm_grant">Grant permission</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="perm_denied_hint">This cannot continue without the permission. You can enable it in the phone’s settings.</string>

