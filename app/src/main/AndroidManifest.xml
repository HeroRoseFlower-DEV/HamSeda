<?xml version="1.0" encoding="utf-8"?>
<!--
  HamSeda permission audit (see README "Permissions" table for the full rationale).

  INTERNET is declared ONLY because Android requires it to open local TCP
  sockets (Wi-Fi Direct peer-to-peer sockets). The app never opens a socket
  to a public IP, never performs DNS for app services, and contains no HTTP
  client, WebView, analytics, or cloud SDK.

  Location permissions are declared ONLY for the Android versions where the
  platform requires them for Wi-Fi Direct / Bluetooth discovery, and each is
  capped with android:maxSdkVersion so it is never requested on newer releases:
    - API 26–28: ACCESS_COARSE_LOCATION (Wi-Fi Direct discovery)
    - API 29–32: ACCESS_FINE_LOCATION  (Wi-Fi Direct discovery)
    - API 33+:   NEARBY_WIFI_DEVICES with neverForLocation (no location use)
    - Bluetooth discovery on API <= 30 also used location; capped the same way.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local peer-to-peer sockets only. Never used for internet traffic. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 17 (API 37): local-network access is blocked by default for
         apps targeting API 37. Wi-Fi Direct group sockets are local-network
         connections, so this must be granted before connecting. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Wi-Fi Direct radio state / P2P operations -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Wi-Fi Direct discovery on Android 13+ (no location derivation) -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Wi-Fi Direct discovery on Android 10–12 (both declared: lint
         requires COARSE alongside FINE) -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />

    <!--
      Bluetooth Classic discovery never derives physical location. On Android
      12+ this assertion is important because fine-location permission is
      capped to API 32 for Wi-Fi Direct's legacy permission model; without
      neverForLocation, modern Bluetooth scan behavior can be rejected on
      devices whose target-SDK permission checks require the location assertion.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Bluetooth Classic on Android 11 and below -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Push-to-talk microphone, requested only when the user starts a session -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground voice service (mic type on API 29+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Ongoing session notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".HamSedaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HamSeda">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
